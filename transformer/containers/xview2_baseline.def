Bootstrap: docker
From: ubuntu:18.04

%environment
    export HOME=/home/appuser
    export PYTHONUNBUFFERED=1
    export TF_CPP_MIN_LOG_LEVEL=2

%post
    apt-get update
    DEBIAN_FRONTEND=noninteractive apt-get install -y python3 python3-pip git curl libgl1-mesa-glx libglib2.0-0
    python3 -m pip install --no-cache-dir "pip<22" "setuptools<60" wheel
    python3 -m pip install --no-cache-dir numpy==1.18.5 scipy==1.4.1 h5py==2.10.0
    python3 -m pip install --no-cache-dir tensorflow==1.15.5 keras==2.2.4
    python3 -m pip install --no-cache-dir matplotlib tqdm Pillow==7.2.0 scikit-image==0.16.2 opencv-python-headless==4.2.0.34 imgaug IPython pandas==1.0.5 shapely==1.7.1 geopandas==0.8.1 imantics simplification==0.5.7 scikit-learn==0.23.2 chainer==7.8.1 tensorboard tensorboardX
    mkdir -p /home/appuser/code /home/appuser/.keras/models /submission /output
    git clone --branch v1.0 --depth 1 https://github.com/DIUx-xView/xView2_baseline.git /home/appuser/code/xview-2
    curl -L https://github.com/DIUx-xView/xView2_baseline/releases/download/v1.0/localization.h5 -o /home/appuser/code/xview-2/weights/localization.h5
    curl -L https://github.com/DIUx-xView/xView2_baseline/releases/download/v1.0/classification.hdf5 -o /home/appuser/code/xview-2/weights/classification.hdf5
    curl -L https://github.com/fchollet/deep-learning-models/releases/download/v0.2/resnet50_weights_tf_dim_ordering_tf_kernels_notop.h5 -o /home/appuser/.keras/models/resnet50_weights_tf_dim_ordering_tf_kernels_notop.h5
    chmod -R a+rX /home/appuser

%runscript
    exec /home/appuser/code/xview-2/submission/run.sh /home/appuser/code/xview-2 "$@"

%labels
    Author DIUx-xView baseline; Texas adapter by DisasterAdaptiveNet
    BaselineVersion v1.0
