{
  "network": "resnext_seamese_unet_shared",
  "encoder": "resnext101",
  "fp16": true,
  "data_multiplier": 2,
  "num_classes": 5,
  "optimizer": {
    "batch_size": 1,
    "type": "FusedSGD",
    "momentum": 0.9,
    "weight_decay": 0.0001,
    "clip": 2,
    "learning_rate": 0.01,
    "schedule": {
      "type": "poly",
      "mode": "step",
      "epochs": 72,
      "params": {
        "max_iter": 512
      }
    }
  },
  "input": {
    "crop_height": 512,
    "crop_width": 512,
    "normalize": {
      "mean": [
        0.485,
        0.456,
        0.406,
        0.485,
        0.456,
        0.406
      ],
      "std": [
        0.229,
        0.224,
        0.225,
        0.229,
        0.224,
        0.225
      ]
    }
  },
  "damage_loss": {
    "type": "FocalLossWithDice",
    "params": {
      "num_classes": 5,
      "ce_weight": 2,
      "d_weight": 0.5,
      "weight": [
        0.5,
        1,
        5,
        2,
        1.3
      ]
    }
  }
}