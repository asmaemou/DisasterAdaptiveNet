{
  "network": "dpn_seamese_unet_shared",
  "encoder": "dpn92",
  "fp16": true,
  "data_multiplier": 2,
  "num_classes": 5,
  "optimizer": {
    "batch_size": 1,
    "type": "FusedAdam",
    "clip": 3,
    "learning_rate": 0.0001,
    "schedule": {
      "type": "step",
      "mode": "epoch",
      "epochs": 60,
      "params": {
        "steps": [
          [
            0,
            3e-05
          ],
          [
            1,
            7e-05
          ],
          [
            10,
            5e-05
          ],
          [
            20,
            2e-05
          ],
          [
            30,
            1e-05
          ],
          [
            50,
            1e-06
          ]
        ]
      }
    }
  },
  "input": {
    "crop_height": 512,
    "crop_width": 512,
    "normalize": {
      "mean": [
        0.485,
        0.456,
        0.406,
        0.485,
        0.456,
        0.406
      ],
      "std": [
        0.229,
        0.224,
        0.225,
        0.229,
        0.224,
        0.225
      ]
    }
  },
  "damage_loss": {
    "type": "FocalLossWithDice",
    "params": {
      "num_classes": 5,
      "ce_weight": 5,
      "d_weight": 0.5,
      "weight": [
        1,
        1,
        5,
        3,
        3
      ]
    }
  }
}