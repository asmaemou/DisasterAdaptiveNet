{
  "network": "efficient_seamese_unet_shared",
  "encoder": "efficientnet-b2",
  "fp16": true,
  "data_multiplier": 2,
  "num_classes": 5,
  "optimizer": {
    "batch_size": 1,
    "type": "FusedAdam",
    "clip": 2,
    "learning_rate": 0.0001,
    "schedule": {
      "type": "step",
      "mode": "epoch",
      "epochs": 70,
      "params": {
        "steps": [
          [
            0,
            0.001
          ],
          [
            1,
            0.0001
          ],
          [
            10,
            5e-05
          ],
          [
            25,
            3e-05
          ],
          [
            40,
            1e-05
          ],
          [
            60,
            5e-06
          ]
        ]
      }
    }
  },
  "input": {
    "crop_height": 512,
    "crop_width": 512,
    "normalize": {
      "mean": [
        0.485,
        0.456,
        0.406,
        0.485,
        0.456,
        0.406
      ],
      "std": [
        0.229,
        0.224,
        0.225,
        0.229,
        0.224,
        0.225
      ]
    }
  },
  "damage_loss": {
    "type": "FocalLossWithDice",
    "params": {
      "num_classes": 5,
      "ce_weight": 2,
      "d_weight": 0.5,
      "weight": [
        1,
        1,
        5,
        3,
        3
      ]
    }
  }
}